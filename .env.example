# Copie para .env (gitignored) e ajuste antes do `docker compose up -d`.

# Domínio (ou host) publicado no TLS interno e usado pelo SSO.
# O redirect_uri do [auth] deve ser https://<CENSO_DOMAIN>/oauth2callback
CENSO_DOMAIN=censo.local

# Portas publicadas no host (mude se 80/443 já estiverem em uso na intranet).
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# Modo de autenticação. Vazio = automático:
#   [auth] nos secrets → oidc  ·  [auth_simples] → senha  ·  nenhum → aberto (dev)
# Aceitos: oidc | senha | aberto
CENSO_AUTH_MODE=
